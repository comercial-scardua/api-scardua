Content-Type: application/json
Authorization: Bearer {{token}}

{
  "caixaViagemId": 0,
  "lancamentos": [
    { "data": "2026-06-21", "custo": "100.00", "clienteFornecedor": "Hotel", "saida": "100.00" }
  ]
}

