### ─────────────────────────────────────────────────────────────
### AUTH
### ─────────────────────────────────────────────────────────────

### Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "acrisio",
  "password": "2529"
}

###

### Refresh token
POST {{baseUrl}}/auth/refresh-token
Content-Type: application/json
Authorization: Bearer {{token}}

{}

###

### Register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nome": "Teste",
  "sobrenome": "Silva",
  "email": "teste@scardua.com.br",
  "cpf": "12345678901",
  "password": "senha123",
  "role": "user"
}

###

### Reset password (GET — verificar username)
GET {{baseUrl}}/auth/reset-password?username=admin@scardua.com.br
Authorization: Bearer {{token}}

###

### Reset password (POST)
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "username": "admin@scardua.com.br",
  "currentPassword": "senhaAtual",
  "newPassword": "novaSenha"
}

###

### Verify password
POST {{baseUrl}}/auth/verify-password
Content-Type: application/json
Authorization: Bearer {{token}}


{
  "username": "acrisio",
  "password": "2529"
}

###

### Verify username (GET)
GET {{baseUrl}}/auth/verify-username?username=admin@scardua.com.br

###

### Verify username (POST)
POST {{baseUrl}}/auth/verify-username
Content-Type: application/json

{
  "username": "angelo.b"
}

###

### Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{token}}

