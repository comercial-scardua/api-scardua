Content-Type: application/json
Authorization: Bearer {{token}}

{
  "caixaViagemId": 1,
  "clearExisting": false,
  "lancamentos": [
    { "data": "2026-06-20", "custo": "150.00", "clienteFornecedor": "Posto Ipiranga", "saida": "150.00" },
    { "data": "2026-06-21", "custo": "80.00", "clienteFornecedor": "Restaurante", "saida": "80.00" }
  ]
}

