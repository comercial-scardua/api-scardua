generator client {
  provider = "prisma-client-js"
  // Gerar o client na pasta .prisma dentro de node_modules (recomendado).
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}
model adiantamento {
  id            Int            @id @default(autoincrement())
  data          DateTime
  saida         String
  observacao    String?        @db.Text
  oculto        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  userId        String?
  caixaViagemId Int?
  colaboradorId Int?
  nome          String         @db.VarChar(255)
  caixaViagem   caixaviagem?   @relation(fields: [caixaViagemId], references: [id])
  colaborador   colaboradores? @relation(fields: [colaboradorId], references: [id])

  @@index([caixaViagemId], map: "Adiantamento_caixaViagemId_idx")
  @@index([colaboradorId], map: "Adiantamento_colaboradorId_idx")
  @@index([userId], map: "Adiantamento_userId_idx")
}

model artigos_kb {
  id              Int      @id @default(autoincrement())
  titulo          String   @db.VarChar(255)
  slug            String   @unique @db.VarChar(255)
  conteudo        String   @db.LongText
  categoria       String?  @db.VarChar(100)
  autor_id        String?  @db.VarChar(255)
  autor_nome      String?  @db.VarChar(255)
  visualizacoes   Int      @default(0)
  util_count      Int      @default(0)
  inutilCount     Int      @default(0)
  tags            String?  @db.Text
  ativo           Boolean  @default(true)
  data_criacao    DateTime @default(now())
  data_modificado DateTime @default(now())

  @@index([ativo])
  @@index([categoria])
  @@index([data_criacao])
}

model audit_logs {
  id                   Int                 @id @default(autoincrement())
  entidade             String              @db.VarChar(50)
  operacao             audit_logs_operacao
  entidadeId           Int
  usuarioId            String?             @db.VarChar(36)
  usuario              String?             @db.VarChar(255)
  descricao            String?             @db.LongText
  alteracoesAnteriores String?             @db.LongText
  alteracoesNovas      String?             @db.LongText
  createdAt            DateTime            @default(now())

  @@index([createdAt])
  @@index([entidade])
  @@index([operacao])
  @@index([usuarioId])
}

model auditoria_suporte {
  id               Int      @id @default(autoincrement())
  ticket_id        Int?
  usuario_id       String?  @db.VarChar(255)
  usuario_nome     String?  @db.VarChar(255)
  acao             String   @db.VarChar(255)
  detalhes         String?  @db.LongText
  tabela_afetada   String?  @db.VarChar(100)
  registro_id      Int?
  dados_anteriores String?  @db.LongText
  dados_novos      String?  @db.LongText
  data_acao        DateTime @default(now())

  @@index([acao])
  @@index([data_acao])
  @@index([ticket_id])
  @@index([usuario_id])
}

model caixaviagem {
  id            Int                @id @default(autoincrement())
  empresaId     Int?
  funcionarioId Int?
  userId        String?
  destino       String
  data          DateTime
  oculto        Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime
  veiculoId     Int?
  numeroCaixa   Int                @default(1)
  observacao    String?
  saldoAnterior Decimal            @default(0.00) @db.Decimal(10, 2)
  empresa       empresas?          @relation(fields: [empresaId], references: [id])
  funcionario   colaboradores?     @relation(fields: [funcionarioId], references: [id])
  user          users?             @relation(fields: [userId], references: [id])
  veiculo       patrimonios?       @relation(fields: [veiculoId], references: [id])
  lancamentos   viagemlancamento[]
  adiantamentos adiantamento[]

  @@index([empresaId], map: "CaixaViagem_empresaId_idx")
  @@index([funcionarioId], map: "CaixaViagem_funcionarioId_idx")
  @@index([userId], map: "CaixaViagem_userId_idx")
  @@index([veiculoId], map: "CaixaViagem_veiculoId_idx")
}

model categorias_suporte {
  id           Int      @id @default(autoincrement())
  nome         String   @unique @db.VarChar(100)
  descricao    String?  @db.Text
  icone        String?  @db.VarChar(100)
  ativo        Boolean  @default(true)
  data_criacao DateTime @default(now())

  @@index([ativo])
}

model colaboradores {
  id                                   Int                     @id @default(autoincrement())
  nome                                 String?
  sobrenome                            String?
  idade                                Int?
  dataNascimento                       DateTime?
  numeroCelular                        String?
  numeroEmergencia                     String?
  setor                                String?
  cargo                                String?
  cpf                                  String?                 @unique
  identidade                           String?
  pis                                  String?
  ctps                                 String?
  cnhNumero                            String?
  cnhVencimento                        DateTime?
  endereco                             String?
  bairro                               String?
  cidade                               String?
  cep                                  String?
  uf                                   String?
  banco                                String?
  bancoNumero                          String?
  contaNumero                          String?
  agenciaNumero                        String?
  tipoVale                             String?
  vt1Valor                             Float?
  tipo                                 String?
  comissao                             Float?
  admissao                             DateTime?
  demissao                             DateTime?
  oculto                               Boolean                 @default(false)
  createdAt                            DateTime                @default(now())
  updatedAt                            DateTime
  empresaId                            Int?
  conjuge                              String?
  email                                String?
  emailProfissional                    String?
  contato                              String?
  estadoCivil                          String?
  filiacao                             String?
  numeroEmpresa                        String?
  userId                               String?                 @unique
  salario                              Decimal?                @db.Decimal(10, 2)
  foto                                 String?                 @db.LongText
  empresa                              empresas?               @relation(fields: [empresaId], references: [id])
  patrimonios                          patrimonios[]
  movimentacoesRealizadas              movimentacoes[]         @relation("MovimentacaoAutor")
  movimentacoesComoResponsavelAnterior movimentacoes[]         @relation("MovimentacaoResponsavelAnterior")
  movimentacoesComoResponsavelNovo     movimentacoes[]         @relation("MovimentacaoResponsavelNovo")
  caixasViagem                         caixaviagem[]
  adiantamentos                        adiantamento[]
  horarioTrabalho                      horarios_trabalho?
  contaCorrenteHoras                   conta_corrente_horas?
  registrosBancoHoras                  registros_banco_horas[]
  contaCorrentes                       conta_corrente[]
  epiCargoId                           Int?
  epiCargo                             epi_cargos?             @relation("ColaboradorEpiCargo", fields: [epiCargoId], references: [id])
  epiMovimentacoes                     epi_movimentacoes[]
  isGestor                             Boolean                 @default(false)
  gestorId                             Int?
  gestor                               colaboradores? @relation("GestorSubordinados", fields: [gestorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subordinados                         colaboradores[]         @relation("GestorSubordinados")
  epiObservacoes                       String?                 @db.Text
  gestorEmpresas                       gestor_empresas[]

  @@index([empresaId])
  @@index([userId])
  @@index([epiCargoId])
  @@index([gestorId])
}

model comentarios {
  id              String           @id
  ticketId        String
  autorNome       String           @db.VarChar(255)
  autorEmail      String?          @db.VarChar(255)
  conteudo        String           @db.LongText
  tipo            comentarios_tipo @default(COMENTARIO)
  interno         Boolean          @default(false)
  anexos          String?          @db.LongText
  dataCriacao     DateTime         @default(now())
  dataAtualizacao DateTime

  @@index([autorEmail])
  @@index([dataCriacao])
  @@index([ticketId])
  @@index([tipo])
}

model conta_corrente {
  id                Int            @id @default(autoincrement())
  empresaId         Int?
  colaboradorId     Int?
  data              DateTime
  tipo              String
  fornecedorCliente String
  observacao        String         @db.Text
  setor             String?
  oculto            Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime
  userId            String?
  empresa           empresas?      @relation(fields: [empresaId], references: [id])
  colaborador       colaboradores? @relation(fields: [colaboradorId], references: [id])
  user              users?         @relation(fields: [userId], references: [id])
  lancamentos       lancamentos[]

  @@index([colaboradorId])
  @@index([empresaId])
  @@index([userId])
}

model conta_corrente_horas {
  id               Int            @id @default(autoincrement())
  funcionario_nome String         @db.VarChar(255)
  total_positivo   Decimal        @default(0.00) @db.Decimal(10, 2)
  total_negativo   Decimal        @default(0.00) @db.Decimal(10, 2)
  saldo            Decimal        @default(0.00) @db.Decimal(10, 2)
  ultimo_registro  DateTime?
  colaborador_id   Int            @unique
  colaborador      colaboradores? @relation(fields: [colaborador_id], references: [id])

  @@index([colaborador_id])
}

model contratos {
  id                       Int                 @id @default(autoincrement())
  numero                   String              @db.VarChar(255)
  titulo                   String              @db.VarChar(255)
  fornecedor               String              @db.VarChar(255)
  valor                    Decimal             @db.Decimal(15, 2)
  data_inicio              DateTime
  data_vencimento          DateTime?
  departamento             String              @db.VarChar(255)
  responsavel              String              @db.VarChar(255)
  descricao                String?             @db.LongText
  status                   String              @default("ativo") @db.VarChar(50)
  vencimento_indeterminado Boolean             @default(false)
  renovacao_automatica     Boolean?            @default(false)
  alertas_ativos           Boolean?            @default(true)
  observacao               String?             @db.Text
  tipo_contrato            String?             @db.VarChar(50)
  data_criacao             DateTime            @default(now())
  data_modificado          DateTime            @default(now())
  arquivos                 contrato_arquivos[]

  @@index([data_criacao])
  @@index([data_vencimento])
  @@index([departamento])
  @@index([fornecedor])
  @@index([numero])
  @@index([status])
}

model contrato_arquivos {
  id              Int        @id @default(autoincrement())
  contrato_id     Int
  nome_original   String     @db.VarChar(255)
  nome            String     @db.VarChar(255)
  caminho_arquivo String     @db.VarChar(255)
  tipo_arquivo    String?    @db.VarChar(100)
  tamanho_arquivo Int?
  data_upload     DateTime   @default(now())
  contrato        contratos? @relation(fields: [contrato_id], references: [id])

  @@index([contrato_id])
}

model empresas {
  id             Int              @id @default(autoincrement())
  numero         String?
  nomeEmpresa    String
  cnpj           String?          @unique
  cidade         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  oculto         Boolean          @default(false)
  criadoPorId    String?
  colaboradores  colaboradores[]
  contaCorrentes conta_corrente[]
  caixasViagem   caixaviagem[]
  criadoPor               users?                      @relation(fields: [criadoPorId], references: [id])
  epiMovimentacoes        epi_movimentacoes[]         @relation("EmpresaEpiMovimentacoes")
  epiEstoqueMovimentacoes epi_estoque_movimentacoes[] @relation("EmpresaEpiEstoqueMovs")
  epiEstoqueFilial        epi_estoque_filial[]        @relation("EmpresaEpiEstoqueFilial")
  gestorEmpresas          gestor_empresas[]

  @@index([criadoPorId])
}

model gestor_empresas {
  id            Int           @id @default(autoincrement())
  colaboradorId Int
  empresaId     Int
  colaborador   colaboradores @relation(fields: [colaboradorId], references: [id])
  empresa       empresas      @relation(fields: [empresaId], references: [id])

  @@unique([colaboradorId, empresaId])
  @@index([colaboradorId])
  @@index([empresaId])
}

model eventos {
  id            Int       @id @default(autoincrement())
  tipo          String    @db.VarChar(100)
  titulo        String    @db.VarChar(255)
  descricao     String?   @db.LongText
  dataInicio    DateTime
  dataFim       DateTime?
  empresaId     Int?
  responsavelId Int?
  cor           String?   @db.VarChar(50)
  criadoPorId   String?
  oculto        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime

  @@index([criadoPorId])
  @@index([empresaId])
  @@index([responsavelId])
}

model foto_colaborador {
  id            Int      @id @default(autoincrement())
  colaboradorId Int      @unique
  foto          String   @db.LongText
  nomeOriginal  String?  @db.VarChar(255)
  mimeType      String?  @db.VarChar(50)
  createdAt     DateTime @default(now())
  updatedAt     DateTime

  @@index([colaboradorId])
}

model historico_tickets {
  id              String                       @id
  ticketId        String
  tipoEvento      historico_tickets_tipoEvento
  descricao       String                       @db.LongText
  autorNome       String?                      @db.VarChar(255)
  autorEmail      String?                      @db.VarChar(255)
  dadosAnteriores String?                      @db.LongText
  dadosNovos      String?                      @db.LongText
  dataCriacao     DateTime                     @default(now())
  dataAtualizacao DateTime

  @@index([autorEmail])
  @@index([dataCriacao])
  @@index([ticketId])
  @@index([tipoEvento])
}

model horarios_trabalho {
  id              Int           @id @default(autoincrement())
  colaboradorId   Int           @unique
  horaInicio      String        @default("07:30")
  horaFim         String        @default("17:30")
  intervaloAlmo_o Int           @default(66) @map("intervaloAlmoço")
  trabalhaSegunda Boolean       @default(true)
  trabalhaTerca   Boolean       @default(true)
  trabalhaQuarta  Boolean       @default(true)
  trabalhaQuinta  Boolean       @default(true)
  trabalhaSexa    Boolean       @default(true)
  trabalhaSabado  Boolean       @default(false)
  trabalhaDomingo Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  colaborador     colaboradores @relation(fields: [colaboradorId], references: [id], map: "horarios_trabalho_colaboradorId_fkey")

  @@index([colaboradorId])
}

model lancamentos {
  id              Int            @id @default(autoincrement())
  contaCorrenteId Int
  data            DateTime
  numeroDocumento String?
  observacao      String         @db.Text
  credito         String?
  debito          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  contaCorrente   conta_corrente @relation(fields: [contaCorrenteId], references: [id])

  @@index([contaCorrenteId])
}

model logpatrimonio {
  id           Int      @id @default(autoincrement())
  acao         String
  patrimonioId Int?
  userId       Int
  detalhes     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model manuais {
  id              Int      @id @default(autoincrement())
  assunto         String   @db.VarChar(255)
  departamento    String   @db.VarChar(100)
  descricao       String?  @db.LongText
  usuario_id      Int?
  usuario_nome    String?  @db.VarChar(255)
  restrito        Boolean  @default(false)
  ativo           Boolean  @default(true)
  data_upload     DateTime @default(now())
  data_modificado DateTime @default(now())

  @@index([ativo, data_modificado])
  @@index([ativo])
  @@index([data_upload])
  @@index([departamento])
  @@index([usuario_id])
}

model manual {
  id              Int      @id @default(autoincrement())
  assunto         String   @db.VarChar(255)
  departamento    String   @db.VarChar(100)
  descricao       String   @db.Text
  usuario_id      String?  @db.VarChar(36)
  usuario_nome    String?  @db.VarChar(100)
  restrito        Boolean  @default(false)
  ativo           Boolean  @default(true)
  data_upload     DateTime @default(now())
  data_modificado DateTime @default(now())

  @@index([ativo], map: "idx_manual_ativo")
  @@index([data_upload], map: "idx_manual_data_upload")
  @@index([departamento], map: "idx_manual_departamento")
  @@index([usuario_id], map: "idx_manual_usuario_id")
}

model manual_arquivo {
  id              Int      @id @default(autoincrement())
  manual_id       Int
  nome_original   String   @db.VarChar(255)
  caminho_arquivo String   @db.VarChar(255)
  tipo_arquivo    String?  @db.VarChar(50)
  tamanho_arquivo Int?
  data_upload     DateTime @default(now())

  @@index([manual_id], map: "manual_id")
}

model manual_arquivos {
  id              Int      @id @default(autoincrement())
  manual_id       Int
  nome_original   String   @db.VarChar(255)
  caminho_arquivo String   @db.VarChar(255)
  tipo_arquivo    String?  @db.VarChar(100)
  tamanho_arquivo Int?
  data_upload     DateTime @default(now())

  @@index([data_upload])
  @@index([manual_id])
}

model erros_solucoes {
  id              Int      @id @default(autoincrement())
  titulo          String   @db.VarChar(255)
  categoria       String   @db.VarChar(100)
  descricao       String?  @db.LongText
  solucao         String?  @db.LongText
  usuario_id      Int?
  usuario_nome    String?  @db.VarChar(255)
  tags            String?  @db.Text
  restrito        Boolean  @default(false)
  ativo           Boolean  @default(true)
  data_upload     DateTime @default(now())
  data_modificado DateTime @default(now())

  @@index([restrito])
  @@index([ativo])
  @@index([categoria])
  @@index([data_upload])
  @@index([usuario_id])
}

model erro_arquivos {
  id              Int      @id @default(autoincrement())
  erro_id         Int
  nome_original   String   @db.VarChar(255)
  caminho_arquivo String   @db.VarChar(255)
  tipo_arquivo    String?  @db.VarChar(100)
  tamanho_arquivo Int?
  data_upload     DateTime @default(now())

  @@index([data_upload])
  @@index([erro_id])
}

model movimentacoes {
  id                    Int            @id @default(autoincrement())
  patrimonioId          Int
  tipo                  String         @db.VarChar(255)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime
  localizacaoAnterior   String?        @db.VarChar(255)
  responsavelAnteriorId Int?
  autorId               Int?
  localizacaoNova       String?        @db.VarChar(255)
  responsavelNovoId     Int?
  kmAnterior            String?        @db.VarChar(20)
  kmNovo                String?        @db.VarChar(20)
  patrimonio            patrimonios    @relation(fields: [patrimonioId], references: [id])
  autor                 colaboradores? @relation("MovimentacaoAutor", fields: [autorId], references: [id])
  responsavelAnterior   colaboradores? @relation("MovimentacaoResponsavelAnterior", fields: [responsavelAnteriorId], references: [id])
  responsavelNovo       colaboradores? @relation("MovimentacaoResponsavelNovo", fields: [responsavelNovoId], references: [id])

  @@index([autorId])
  @@index([patrimonioId])
  @@index([responsavelAnteriorId])
  @@index([responsavelNovoId])
}

model movimentacao_veiculos {
  id                    Int       @id @default(autoincrement())
  patrimonioId          Int
  responsavelAnteriorId Int?
  responsavelNovoId     Int?
  autorId               Int?
  tipo                  String    @db.VarChar(100)
  justificativa         String?   @db.VarChar(500)
  dataInicio            DateTime  @default(now()) @db.DateTime(0)
  dataFim               DateTime? @db.DateTime(0)
  createdAt             DateTime  @default(now()) @db.DateTime(0)
  updatedAt             DateTime  @default(now()) @db.DateTime(0)

  @@index([autorId], map: "fk_movveic_autor")
  @@index([patrimonioId], map: "idx_movveic_patrimonio")
  @@index([responsavelAnteriorId], map: "idx_movveic_resp_anterior")
  @@index([responsavelNovoId], map: "idx_movveic_resp_novo")
}

model ncm {
  id                Int      @id @default(autoincrement())
  codigo_ncm        String   @db.VarChar(20)
  categoria_cliente String   @db.VarChar(100)
  empresa           String   @db.VarChar(100)
  icms_dentro       Decimal  @default(0.00) @db.Decimal(10, 2)
  icms_fora         Decimal  @default(0.00) @db.Decimal(10, 2)
  fora_st           String   @default("Não") @db.VarChar(20)
  fora_difal        String   @default("Não") @db.VarChar(20)
  monofasico        String   @default("Não") @db.VarChar(20)
  pis               Decimal  @default(0.00) @db.Decimal(10, 2)
  cofins            Decimal  @default(0.00) @db.Decimal(10, 2)
  ipi               Decimal  @default(0.00) @db.Decimal(10, 2)
  bc_pis_cof        String   @default("") @db.VarChar(10)
  bc_icms           String   @default("") @db.VarChar(10)
  mva               Decimal  @default(0.00) @db.Decimal(10, 2)
  uf_emissor        String   @db.VarChar(2)
  uf_destino        String   @db.VarChar(2)
  aliquota          Decimal  @default(0.00) @db.Decimal(10, 2)
  cst_origem        String   @default("") @db.VarChar(10)
  obs_fonte         String?  @db.Text
  usuario_id        Int?
  usuario_nome      String?  @db.VarChar(255)
  data_upload       DateTime @default(now())
  data_modificado   DateTime @default(now())
  ativo             Boolean  @default(true)

  @@unique([codigo_ncm, categoria_cliente, empresa, uf_emissor, uf_destino, cst_origem])
  @@index([ativo])
  @@index([categoria_cliente])
  @@index([codigo_ncm])
  @@index([data_upload])
  @@index([empresa])
  @@index([uf_destino])
  @@index([uf_emissor])
}

model notas_internas {
  id              String                  @id
  ticketId        String
  autorNome       String                  @db.VarChar(255)
  autorEmail      String                  @db.VarChar(255)
  conteudo        String                  @db.LongText
  tipoAcao        notas_internas_tipoAcao
  dataCriacao     DateTime                @default(now())
  dataAtualizacao DateTime

  @@index([autorEmail])
  @@index([dataCriacao])
  @@index([ticketId])
  @@index([tipoAcao])
}

model notificacao_preferencias {
  id                    String   @id
  usuarioId             String   @unique
  notifyNovaAtribuicao  Boolean  @default(true)
  notifyMudancaStatus   Boolean  @default(true)
  notifyNovoComentario  Boolean  @default(true)
  notifyEscalacaoPriori Boolean  @default(true)
  notificacoesEmail     Boolean  @default(true)
  notificacoesInApp     Boolean  @default(true)
  notificarSeusTkets    Boolean  @default(true)
  notificarAtribuidos   Boolean  @default(true)
  dataCriacao           DateTime @default(now())
  dataAtualizacao       DateTime

  @@index([usuarioId])
}

model notificacoes {
  id              String            @id
  usuarioId       String
  ticketId        String?
  tipo            notificacoes_tipo
  titulo          String            @db.VarChar(255)
  mensagem        String            @db.LongText
  lida            Boolean           @default(false)
  ticketTitulo    String?           @db.VarChar(255)
  autorNome       String?           @db.VarChar(255)
  dataCriacao     DateTime          @default(now())
  dataAtualizacao DateTime

  @@index([dataCriacao])
  @@index([lida])
  @@index([ticketId])
  @@index([usuarioId])
  @@index([usuarioId, lida, dataCriacao])
}

model patrimonios {
