  saidaId           Int?     @unique
  entradaId         Int?     @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([epiId])
  @@index([empresaOrigemId])
  @@index([empresaDestinoId])
  @@index([dataTransferencia])
}
